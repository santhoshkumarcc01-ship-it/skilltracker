    "@supabase/supabase-js": "2.119.2",
    "@tanstack/react-query": "^5.59.20",
    "argon2": "^0.41.1",
    "framer-motion": "12.43.0",
    "howler": "^2.2.4",
    "html-to-image": "^1.11.13",
    "isomorphic-dompurify": "^4.8.0",
    "jose": "^5.9.6",
