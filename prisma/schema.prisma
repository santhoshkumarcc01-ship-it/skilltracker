generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  displayName  String
  passwordHash String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  profile      Profile?
  sessions     Session[]
  auditLogs    AuditLog[]
  tasks        Task[]
  dayLogs      DayLog[]
  stats        UserStats?
  pet          UserPet?
  preferences  Preferences?
  items        UserItem[]
  achievements Achievement[]
  notifications Notification[]
  leagues      WeeklyLeague[]
  friendLinks  Friendship[] @relation("FriendOwner")
  friendOf     Friendship[] @relation("FriendTarget")
  sentInvites FriendInvite[] @relation("InviteSender")
  receivedInvites FriendInvite[] @relation("InviteReceiver")
  blocksMade UserBlock[] @relation("Blocker")
  blocksReceived UserBlock[] @relation("Blocked")
  duoStreaksA DuoStreak[] @relation("DuoA")
  duoStreaksB DuoStreak[] @relation("DuoB")
  goalsCreated SharedStudyGoal[] @relation("GoalCreator")
  goalsJoined SharedStudyGoal[] @relation("GoalPartner")
  goalProgress SharedGoalProgress[]
  memories     Memory[]
  materials    Material[]
  folders      MaterialFolder[]
  pendingUploads PendingUpload[]
  storedFiles  StoredFile[]
  weeklyReports WeeklyReport[]
  motivationNotes MotivationNote[]
  favoriteQuotes FavoriteQuote[]
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  friendToken String   @unique @db.VarChar(10)
  timezone    String   @default("UTC")
  dailyGoal   Int      @default(3)
  pet         String?
  onboarded   Boolean  @default(false)
  shareStreak Boolean  @default(true)
  shareXp     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  familyId         String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedById     String?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId, expiresAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  emailHash String?
  ipHash    String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model Task {
  id                  String    @id @default(cuid())
  userId              String
  localDate           String    @db.VarChar(10)
  title               String    @db.VarChar(120)
  category            String    @db.VarChar(40)
  scheduledStart      String    @db.VarChar(5)
  plannedMinutes      Int
  position            Int       @default(0)
  startedAt           DateTime?
  elapsedSeconds      Int       @default(0)
  timerRunningSince   DateTime?
  completedAt         DateTime?
  awardedXp           Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, localDate, position])
}

model DayLog {
  id          String   @id @default(cuid())
  userId      String
  localDate   String   @db.VarChar(10)
  status      String   @default("PARTIAL")
  xpEarned    Int      @default(0)
  gemsEarned  Int      @default(0)
  chestXp     Int      @default(0)
  chestGems   Int      @default(0)
  chestExpiresAt DateTime?
  chestClaimedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localDate])
  @@index([userId, localDate])
}

model UserPet {
  id             String   @id @default(cuid())
  userId         String   @unique
  species        String   @default("cat")
  name           String   @default("Biscuit")
  bondXp         Int      @default(0)
  bondLevel      Int      @default(1)
  equippedHat    String?
  equippedGlasses String?
  equippedScarf  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Preferences {
  id             String   @id @default(cuid())
  userId         String   @unique
  reduceFomo     Boolean  @default(false)
  soundMuted     Boolean  @default(false)
  soundVolume    Float    @default(0.45)
  ambientEnabled Boolean  @default(true)
  theme          String   @default("light") @db.VarChar(8)
  reduceMotion   Boolean  @default(false)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt      DateTime @updatedAt
}

model ShopItem {
  id          String   @id
  name        String
  description String
  category    String
  price       Int
  emoji       String
  color       String
  createdAt   DateTime @default(now())
  purchases   UserItem[]
}

model UserItem {
  id          String   @id @default(cuid())
  userId      String
  itemId      String
  purchasedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item        ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId, purchasedAt])
}

model Achievement {
  id         String   @id @default(cuid())
  userId     String
  key        String
  unlockedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, unlockedAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime @default(now())
  expiresAt DateTime?
  dedupeKey String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@unique([userId, dedupeKey])
}

model WeeklyLeague {
  id        String   @id @default(cuid())
  userId    String
  weekStart String   @db.VarChar(10)
  league    String   @default("BRONZE")
  weeklyXp  Int      @default(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([weekStart, league, weeklyXp])
}

model WeeklyReport {
  id        String   @id @default(cuid())
  userId    String
  weekStart String   @db.VarChar(10)
  timezone  String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([weekStart])
}

model Friendship {
  id        String   @id @default(cuid())
  userId    String
  friendId  String
  createdAt DateTime @default(now())
  user      User     @relation("FriendOwner", fields: [userId], references: [id], onDelete: Cascade)
  friend    User     @relation("FriendTarget", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([friendId])
}

model FriendInvite {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  respondedAt DateTime?
  sender      User     @relation("InviteSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User     @relation("InviteReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  @@index([receiverId, status, createdAt])
  @@index([senderId, status, createdAt])
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  @@unique([blockerId, blockedId])
}

model DuoStreak {
  id          String   @id @default(cuid())
  userAId     String
  userBId     String
  current     Int      @default(0)
  longest     Int      @default(0)
  lastDuoDate String?  @db.VarChar(10)
  userA       User     @relation("DuoA", fields: [userAId], references: [id], onDelete: Cascade)
  userB       User     @relation("DuoB", fields: [userBId], references: [id], onDelete: Cascade)
  @@unique([userAId, userBId])
}

model SharedStudyGoal {
  id          String   @id @default(cuid())
  creatorId   String
  partnerId   String
  title       String   @db.VarChar(120)
  targetDays  Int
  startDate   String   @db.VarChar(10)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  creator     User     @relation("GoalCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  partner     User     @relation("GoalPartner", fields: [partnerId], references: [id], onDelete: Cascade)
  progress    SharedGoalProgress[]
  @@index([creatorId, createdAt])
  @@index([partnerId, createdAt])
}

model SharedGoalProgress {
  id        String   @id @default(cuid())
  goalId    String
  userId    String
  localDate String   @db.VarChar(10)
  createdAt DateTime @default(now())
  goal      SharedStudyGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([goalId, userId, localDate])
}

model UserStats {
  id               String   @id @default(cuid())
  userId           String   @unique
  xp               Int      @default(0)
  gems             Int      @default(0)
  hearts           Int      @default(5)
  currentStreak    Int      @default(0)
  longestStreak    Int      @default(0)
  streakFreezeCount Int     @default(0)
  lastCompletedDate String? @db.VarChar(10)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PendingUpload {
  id            String   @id @default(cuid())
  userId        String
  objectKey     String   @unique
  declaredMime  String
  declaredSize  Int
  purpose       String   @default("story")
  expiresAt     DateTime
  confirming    Boolean  @default(false)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model StoredFile {
  id           String   @id @default(cuid())
  userId       String
  objectKey    String   @unique
  mimeType     String
  size         Int
  thumbnailKey String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaFor     Memory[] @relation("MemoryMedia")
  posterFor    Memory[] @relation("MemoryPoster")
  materialFor Material[]
  motivationFor MotivationNote[]

  @@index([userId, createdAt])
}

model MotivationNote {
  id          String     @id @default(cuid())
  userId      String
  kind        String     @db.VarChar(8)
  text        String     @default("") @db.VarChar(1200)
  quote       String?    @db.VarChar(400)
  attribution String?    @db.VarChar(120)
  fileId      String?
  color       String     @default("lemon") @db.VarChar(16)
  paperStyle  String     @default("lined") @db.VarChar(16)
  x           Float      @default(5)
  y           Float      @default(5)
  width       Float      @default(24)
  height      Float      @default(28)
  rotation    Float      @default(0)
  zIndex      Int        @default(1)
  pinned      Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  file        StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([userId, zIndex])
  @@index([userId, updatedAt])
}

model FavoriteQuote {
  id        String   @id @default(cuid())
  userId    String
  quote     String   @db.VarChar(400)
  author    String   @db.VarChar(120)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, quote, author])
  @@index([userId, createdAt])
}

model MaterialFolder {
  id        String           @id @default(cuid())
  userId    String
  parentId  String?
  name      String           @db.VarChar(80)
  color     String           @default("green") @db.VarChar(16)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    MaterialFolder?  @relation("FolderTree", fields: [parentId, userId], references: [id, userId], onDelete: Cascade)
  children  MaterialFolder[] @relation("FolderTree")
  materials Material[]

  @@unique([id, userId])
  @@index([userId, parentId, name])
}

model Material {
  id          String         @id @default(cuid())
  userId      String
  folderId    String?
  fileId      String?
  type        String         @db.VarChar(12)
  title       String         @db.VarChar(160)
  content     String         @default("") @db.Text
  url         String?        @db.VarChar(2048)
  tags        String[]       @default([])
  pinned      Boolean        @default(false)
  favourite   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder      MaterialFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  file        StoredFile?    @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([userId, type, updatedAt])
  @@index([userId, folderId, updatedAt])
  @@index([userId, pinned, favourite, updatedAt])
}

model Memory {
  id           String     @id @default(cuid())
  userId       String
  title        String     @db.VarChar(120)
  story        String     @db.VarChar(8000)
  tags         String[]   @default([])
  occurredAt   DateTime
  mood         String?    @db.VarChar(24)
  sourceUrl    String?    @db.VarChar(2048)
  mediaFileId  String?
  posterFileId String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaFile    StoredFile? @relation("MemoryMedia", fields: [mediaFileId], references: [id], onDelete: SetNull)
  posterFile   StoredFile? @relation("MemoryPoster", fields: [posterFileId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt, id])
  @@index([userId, mood, occurredAt])
}
